# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Working notes. These stay on the machine.
#
# CONTENT-CHECKLIST.md records what the church has not confirmed yet, and in
# doing so is a note to ourselves about an outside organisation
# rather than anything a reader of this repository needs, and is
# not this repository's to hand out.
# Anything meant for readers goes in README.md instead.
CONTENT-CHECKLIST.md
